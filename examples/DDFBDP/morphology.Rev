# Run from repository root: .local-build/revbayes-build/rb examples/DDFBDP/morphology.Rev
# A smoke test, not a converged empirical analysis. Tutorial bear morphology only.
seed(20261004)
taxa <- readTaxonData("examples/DDFBDP/data/bears_taxa.tsv")
morpho <- readDiscreteCharacterData("examples/DDFBDP/data/bears_morphology.nex")
morpho.addMissingTaxa(taxa)
moves = VectorMoves()
lambda0 ~ dnExponential(10)
lambda0.setValue(.2)
alpha ~ dnExponential(10)
alpha.setValue(.05)
mu ~ dnExponential(10)
mu.setValue(.1)
psi ~ dnExponential(10)
psi.setValue(.15)
origin ~ dnUniform(37.2,55)
origin.setValue(45)
moves.append(mvScale(lambda0,lambda=.5,weight=2))
moves.append(mvScale(alpha,lambda=.5,weight=2))
moves.append(mvScale(mu,lambda=.5,weight=2))
moves.append(mvScale(psi,lambda=.5,weight=2))
moves.append(mvSlide(origin,delta=2,weight=2))

# N includes all living lineages, whether observed or hidden.
# lambda(N) = lambda0 * exp(-alpha*(N-1)); constant extinction and preservation.
tree ~ dnDDFBDP(originAge=origin,lambda0=lambda0,alpha=alpha,mu=mu,psi=psi,rho=1,
                taxa=taxa,condition="sampling",maxHiddenLineages=128)
moves.append(mvFNPR(tree,weight=10))
moves.append(mvCollapseExpandFossilBranch(tree,origin,weight=6))
moves.append(mvNodeTimeSlideUniform(tree,weight=10))
moves.append(mvRootTimeSlideUniform(tree,origin,weight=2))
moves.append(mvFossilTimeSlideUniform(tree,origin,weight=4))
# These bounds describe each specimen's uncertain age, not species ranges.
fossils = tree.getFossils()
for (i in 1:fossils.size()) {
    age[i] := tmrca(tree,clade(fossils[i]))
    lower = fossils[i].getMinAge()
    upper = fossils[i].getMaxAge()
    fossilAge[i] ~ dnUniform(age[i]-upper,age[i]-lower)
    fossilAge[i].clamp(0)
}
shape ~ dnExponential(1)
rates := fnDiscretizeGamma(shape,shape,4)
clock ~ dnExponential(1)
clock.setValue(.02)
moves.append(mvScale(shape,lambda=.5,weight=2))
moves.append(mvScale(clock,lambda=.5,weight=2))
Q := fnJC(2)
morphology ~ dnPhyloCTMC(tree=tree,Q=Q,siteRates=rates,branchRates=clock,type="Standard",coding="variable")
morphology.clamp(morpho)
numAncestors := tree.numSampledAncestors()
myModel = model(tree)
monitors = VectorMonitors()
monitors.append(mnModel(filename="output/DDFBDP/morphology.log",printgen=10))
monitors.append(mnFile(filename="output/DDFBDP/morphology.trees",printgen=10,tree))
monitors.append(mnScreen(printgen=100,lambda0,alpha,mu,psi,numAncestors))
analysis = mcmc(myModel,monitors,moves)
analysis.run(generations=1000)
analysis.operatorSummary()
print("DDFBDP_MORPHOLOGY_PASS")
q()
