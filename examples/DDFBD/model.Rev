seed(73141)
moves = VectorMoves()
initial_tree <- readTrees("data/extended_species.tre")[1]

# All recovered records are included once; A and B have repeated occurrences.
occurrence_species <- v("A", "A", "B", "B", "C")
occurrence_names <- v("A_old", "A_young", "B_old", "B_young", "C_fossil")
fossil_age[1] ~ dnUniform(3.8, 4.2)
fossil_age[2] ~ dnUniform(1.8, 2.2)
fossil_age[3] ~ dnUniform(1.8, 2.2)
fossil_age[4] ~ dnUniform(0.8, 1.2)
fossil_age[5] ~ dnUniform(0.8, 1.2)
for (i in 1:5) {
    moves.append(mvSlide(fossil_age[i], delta=0.2, weight=1))
}

lambda0 ~ dnExponential(2)
alpha ~ dnExponential(5)
mu ~ dnExponential(5)
psi ~ dnExponential(2)
lambda0.setValue(0.5)
alpha.setValue(0.2)
mu.setValue(0.2)
psi.setValue(0.3)
rho <- 0.7
origin ~ dnUniform(5.5, 10.0)
origin.setValue(7.0)
moves.append(mvScale(lambda0, lambda=0.4, weight=2))
moves.append(mvSlide(alpha, delta=0.2, weight=2))
moves.append(mvScale(mu, lambda=0.4, weight=2))
moves.append(mvScale(psi, lambda=0.4, weight=2))
moves.append(mvSlide(origin, delta=1.0, weight=1))

species_tree ~ dnDDFBD(originAge=origin, lambda0=lambda0, alpha=alpha,
    mu=mu, psi=psi, rho=rho,
    occurrenceSpecies=occurrence_species, occurrenceAges=fossil_age,
    sampledExtant=v("A", "C"), initialTree=initial_tree,
    condition="none", maxHiddenLineages=64, numericalTolerance=1e-12)

# Child order carries budding orientation. Use the ordered, reversible move.
moves.append(mvOrderedTreeSwap(species_tree, weight=4))
moves.append(mvNodeTimeSlideUniform(species_tree, weight=3))
moves.append(mvRootTimeSlideUniform(species_tree, origin=origin, weight=2))
# B's tip is its unobserved extinction time, constrained by its fossil record.
endpoint_min <- 0.0
# The B occurrence intervals do not overlap, so record 4 is always youngest.
endpoint_max := fossil_age[4]
moves.append(mvTipTimeSlideUniform(species_tree, tip="B", min=endpoint_min,
    max=endpoint_max, delta=0.3, weight=2))

sample_names <- v("A_old", "A_young", "B_old", "B_young", "C_fossil", "A_now", "C_now")
sample_species <- v("A", "A", "B", "B", "C", "A", "C")
sample_ages := v(fossil_age[1], fossil_age[2], fossil_age[3],
    fossil_age[4], fossil_age[5], 0.0, 0.0)
observation_tree := fnSpeciesObservationTree(species_tree,
    sampleNames=sample_names, speciesNames=sample_species, ages=sample_ages)

if (use_morphology) {
    morph <- readDiscreteCharacterData("data/morphology.nex")
    morph_clock ~ dnExponential(2)
    morph_clock.setValue(0.2)
    moves.append(mvScale(morph_clock, lambda=0.3, weight=2))
    morphological_data ~ dnPhyloCTMC(tree=observation_tree, Q=fnJC(2),
        branchRates=morph_clock, type="Standard", coding="variable")
    morphological_data.clamp(morph)
}
if (use_dna) {
    dna <- readDiscreteCharacterData("data/dna.nex")
    dna_clock ~ dnExponential(10)
    dna_clock.setValue(0.05)
    moves.append(mvScale(dna_clock, lambda=0.3, weight=2))
    molecular_data ~ dnPhyloCTMC(tree=observation_tree, Q=fnJC(4),
        branchRates=dna_clock, type="DNA")
    molecular_data.clamp(dna)
}

joint_model = model(species_tree, endpoint_min, endpoint_max)
monitors = VectorMonitors()
monitors.append(mnModel(filename="output/"+prefix+".log", printgen=10))
monitors.append(mnFile(filename="output/"+prefix+".species.trees", printgen=10, species_tree))
monitors.append(mnFile(filename="output/"+prefix+".observations.trees", printgen=10, observation_tree))
analysis = mcmc(joint_model, monitors, moves)
analysis.run(generations=generations)
analysis.operatorSummary()
