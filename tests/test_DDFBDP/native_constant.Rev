# Run from repository root. Native constant-rate normalization regression.
# Native BDSTP survival uses P(sampled extant)/rho. The new prior uses the
# actual sampled-extant probability. Subtract ln(rho) from native survival
# densities before comparison. All other comparisons are direct.
taxa <- readTaxonData("tests/test_DDFBDP/data/ancestor.tsv")
initial <- readTrees("tests/test_DDFBDP/data/ancestor.tre")[1]
old ~ dnBDSTP(lambda=.4, r=0, mu=.15, psi=.2, rho=0.4, originAge=3, taxa=taxa, initialTree=initial, condition="time")
new ~ dnDDFBDP(lambda0=.4, alpha=0, maxHiddenLineages=128, mu=.15, psi=.2, rho=0.4, originAge=3, taxa=taxa, initialTree=initial, condition="time")
difference <- abs(old.lnProbability()-new.lnProbability())
print("NATIVE_COMPARE ancestor 0.4 time " + old.lnProbability() + " " + new.lnProbability() + " " + difference)
if (difference > 1e-8) { stop("DDFBDP constant-rate mismatch") }
old ~ dnBDSTP(lambda=.4, r=0, mu=.15, psi=.2, rho=0.4, originAge=3, taxa=taxa, initialTree=initial, condition="sampling")
new ~ dnDDFBDP(lambda0=.4, alpha=0, maxHiddenLineages=128, mu=.15, psi=.2, rho=0.4, originAge=3, taxa=taxa, initialTree=initial, condition="sampling")
difference <- abs(old.lnProbability()-new.lnProbability())
print("NATIVE_COMPARE ancestor 0.4 sampling " + old.lnProbability() + " " + new.lnProbability() + " " + difference)
if (difference > 1e-8) { stop("DDFBDP constant-rate mismatch") }
old ~ dnBDSTP(lambda=.4, r=0, mu=.15, psi=.2, rho=0.4, originAge=3, taxa=taxa, initialTree=initial, condition="survival")
new ~ dnDDFBDP(lambda0=.4, alpha=0, maxHiddenLineages=128, mu=.15, psi=.2, rho=0.4, originAge=3, taxa=taxa, initialTree=initial, condition="survival")
difference <- abs(old.lnProbability()-new.lnProbability()-ln(0.4))
print("NATIVE_COMPARE ancestor 0.4 survival " + old.lnProbability() + " " + new.lnProbability() + " " + difference)
if (difference > 1e-8) { stop("DDFBDP constant-rate mismatch") }
