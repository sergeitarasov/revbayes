difference <- abs(old.lnProbability()-new.lnProbability()-ln(0.4))
print("NATIVE_COMPARE extant_only 0.4 survival " + old.lnProbability() + " " + new.lnProbability() + " " + difference)
if (difference > 1e-8) { stop("DDFBDP constant-rate mismatch") }
old ~ dnBDSTP(lambda=.4, r=0, mu=.15, psi=.2, rho=1.0, originAge=3, taxa=taxa, initialTree=initial, condition="time")
new ~ dnDDFBDP(lambda0=.4, alpha=0, maxHiddenLineages=128, mu=.15, psi=.2, rho=1.0, originAge=3, taxa=taxa, initialTree=initial, condition="time")
difference <- abs(old.lnProbability()-new.lnProbability())
print("NATIVE_COMPARE extant_only 1.0 time " + old.lnProbability() + " " + new.lnProbability() + " " + difference)
if (difference > 1e-8) { stop("DDFBDP constant-rate mismatch") }
